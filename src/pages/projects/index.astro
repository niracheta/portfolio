---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Infrastructure, networking, automation, and self-hosted AI projects by Nicolas Iracheta, with write-ups on how each was built and what it fixed.">
  <h1>Projects</h1>
  <ul class="cards">
    {projects.map((p) => (
      <li>
        <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
        <p>{p.data.summary}</p>
        <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
      </li>
    ))}
  </ul>
</Base>
